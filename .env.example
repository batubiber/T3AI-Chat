# T3AI Backend Configuration
# =============================

# vLLM Endpoint URL (backend /api/chat fallback + /api/health)
# ÖNEMLİ: Ana sohbet bunu KULLANMAZ — tarayıcı nginx /vllm-8001/ (GLM) ve /vllm-8000/ (Gemma) üzerinden gider.
# Ana sohbet modeli (GLM 5.2)
VLLM_ENDPOINT=http://vllm-a.example:8000/v1/chat/completions

# vLLM API Key (opsiyonel)
# Internal network'te genellikle boş bırakılır
VLLM_API_KEY=token-yok

# Backend Port
PORT=3001

# Model Configuration (shared by both frontend and backend)
# Note: Variables must start with VITE_ prefix to be accessible in frontend
VITE_MODEL_NAME=glm-5.2
VITE_DEFAULT_TEMPERATURE=0.6
VITE_DEFAULT_MAX_TOKENS=4096
VITE_DEFAULT_TOP_P=0.95
VITE_TOKEN_SAFETY_BUFFER=8192
VITE_DEFAULT_TOP_K=20
VITE_DEFAULT_MIN_P=0
VITE_MODEL_MAX_CONTEXT_LENGTH=262144
MAX_OUTPUT_TOKENS_CAP=16384

# GLM 5.2 (frontend, build-time — değişiklik REBUILD ister)
# NOT: VITE_GLM_CONTEXT_WINDOW, GLM vLLM --max-model-len ile EŞLEŞMELİ (aşarsa uzun sohbet hata verir).
VITE_GLM_TEMPERATURE=1.0
VITE_GLM_TOP_P=0.95
VITE_GLM_CONTEXT_WINDOW=131072

# Özetleme/başlık — gemma-4-31b (vllm-b.example:8000)
#
# SUMMARY_MODEL_NAME sunucudaki --served-model-name ile ELDE tutulmak zorunda
# DEĞİL: uygulama 404 alırsa /v1/models'i sorup gerçek adı bulur, isteği o adla
# yeniler ve konsola bir uyarı düşer. Yine de burayı güncel tutmak iyi olur —
# her süreç başlangıcında bir istek boşa gidiyor.
SUMMARY_VLLM_ENDPOINT=http://vllm-b.example:8000/v1/chat/completions
SUMMARY_MODEL_NAME=gemma-4-31b

# Frontend'in kullanım kırılımında özetleme çağrısını DOĞRU model adıyla
# bildirmesi için — yukarıdaki SUMMARY_MODEL_NAME ile ELDE EŞLEŞMELİ. Backend
# zaten özetleme isteğinin gövdesindeki `model` alanını yok sayıp her zaman
# SUMMARY_MODEL_NAME'i kullanıyor; bu değer yalnız merkezî kullanım logundaki
# etiketleme içindir (server'a gönderilmez, isteğin hedefini DEĞİŞTİRMEZ).
VITE_SUMMARY_MODEL_NAME=gemma-4-31b

# Compact (özetleme) tetik eşiği — mutlak token. Tanımlıysa sohbet bu token sayısını
# aşınca özet oluşur. Hem eşik HEM pencere bu değere çekilir (modelin bütçesini aşamaz);
# boş bırakılırsa modelin context window'una göre otomatik hesaplanır. Test için düşük
# verin (örn. 800). NOT: VITE_ önekli → dev/derleme başında okunur, değişince dev'i
# yeniden başlatın. Ayrıca compact'in tetiklenmesi için >MIN_MESSAGES_TO_KEEP (6) mesaj gerekir.
# VITE_SUMMARY_TRIGGER=

# YALNIZ KİMLİK yazın. Dil, biçim (LaTeX/kod bloğu) ve belge yeteneği
# kuralları uygulamanın içinde (src/lib/sistemPromptu.ts) ve bu satırın
# arkasına otomatik ekleniyor — buraya tekrar yazmayın.
VITE_SYSTEM_PROMPT_BASE="You are T3AI, an AI assistant developed in Türkiye by the T3 Foundation as part of the Milli Teknoloji Hamlesi."

# Admin parolası — SUNUCU tarafında kalır, JS paketine GİRMEZ.
# VITE_ önekli KULLANMA: VITE_* derleme zamanında pakete gömülür ve parola
# tarayıcıdan okunabilir hale gelir.
ADMIN_PASSWORD=degistir-beni
# Jeton imza sırrı (isteğe bağlı; verilmezse paroladan türetilir)
# ADMIN_TOKEN_SECRET=

# Gemma-4 31B (frontend, build-time — HF best-practice: temp 1.0 / top_p 0.95 / top_k 64)
VITE_GEMMA_TEMPERATURE=1.0
VITE_GEMMA_TOP_P=0.95
VITE_GEMMA_TOP_K=64
VITE_GEMMA_CODING_TEMPERATURE=0.6
# Gemma vLLM --max-model-len ile EŞLEŞMELİ (gemma tuzağı; VITE_ → değişince REBUILD):
VITE_GEMMA_CONTEXT_WINDOW=262144


# Embedding (RAG) — bge-m3 @ vllm-b.example:8002
EMBEDDING_ENDPOINT=http://vllm-b.example:8002/v1/embeddings
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024

# OCR (Unlimited-OCR vLLM servisi)
OCR_ENDPOINT=http://vllm-b.example:8003/v1/chat/completions
OCR_MODEL=baidu/Unlimited-OCR

# Model metrics panel kaynakları (backend /api/model-metrics)
METRICS_GLM_URL=http://vllm-a.example:8000/metrics
METRICS_GEMMA_URL=http://vllm-b.example:8000/metrics

# GLM gateway x-user-id header'ı (backend metrics fetch için). nginx de /vllm-8001/'de aynı değeri
# enjekte eder (proxy_set_header x-user-id) — iki yeri BİRLİKTE değiştir.
GLM_USER_ID=t3ai-chat