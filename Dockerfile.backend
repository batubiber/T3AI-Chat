FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY server/package*.json ./

# Install dependencies (with extended timeouts for slow/unstable networks)
RUN npm config set fetch-timeout 600000 \
 && npm config set fetch-retries 5 \
 && npm config set fetch-retry-mintimeout 20000 \
 && npm config set fetch-retry-maxtimeout 120000 \
 && npm ci --omit=dev --no-audit --no-fund

# Copy source files
# *.js — TEK TEK DEĞİL: index.js dışında modül eklenince (adminJeton.js gibi)
# imaja girmiyordu ve konteyner "Cannot find module" ile hiç açılmıyordu.
# Host'ta test edildiğinde dosya orada olduğu için sorun görünmüyordu.
COPY server/*.js ./

# Expose port
EXPOSE 3001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3001/api/health || exit 1

CMD ["node", "index.js"]
